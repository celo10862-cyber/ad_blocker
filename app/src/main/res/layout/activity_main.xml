<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="NetShield AdBlocker"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Protection: OFF"
        android:textColor="#FF5252"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ads Blocked: 0 | Active Rules: 48"
        android:textColor="#B0BEC5"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnToggleVpn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Enable System-Wide Ad Shield" />

    <Button
        android:id="@+id/btnOpenYoutube"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Open Ad-Free YouTube" />

    <Button
        android:id="@+id/btnOpenBrowser"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Open Popup-Free Web Browser" />

    <Button
        android:id="@+id/btnUpdateHosts"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Sync Online Blocklists (100k+ Domains)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCustomDomain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Block custom domain (e.g. ads.site.com)"
            android:textColor="#FFFFFF"
            android:textColorHint="#757575" />

        <Button
            android:id="@+id/btnAddDomain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Block" />
    </LinearLayout>
</LinearLayout>
